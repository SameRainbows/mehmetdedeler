{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mehmetdedeler",
  "compatibility_date": "2026-09-25",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page"
  },
  "routes": [
    { "pattern": "mehmetdedeler.com", "custom_domain": true },
    { "pattern": "www.mehmetdedeler.com", "custom_domain": true }
  ]
}
